{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lumina-dev-ace/Riemann-Search-for-App/blob/main/schemas/research-record.schema.json",
  "title": "RiemannSearch Research Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "created_utc", "contributor", "app_version", "numerical_backend", "precision_bits", "start_index", "end_index", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9._-]+$" },
    "created_utc": { "type": "string", "format": "date-time" },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": { "display_name": { "type": "string", "minLength": 1, "maxLength": 80 } }
    },
    "app_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "numerical_backend": { "enum": ["FLINT/Arb"] },
    "precision_bits": { "type": "integer", "minimum": 32 },
    "start_index": { "type": "integer", "minimum": 1 },
    "end_index": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "status", "ordinate_interval", "verification"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["candidate", "evaluated", "arb_verified"] },
          "ordinate_interval": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "string" }],
            "minItems": 2,
            "maxItems": 2
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "backend", "certified", "precision_bits"],
            "properties": {
              "method": { "enum": ["none", "arb_interval"] },
              "backend": { "enum": ["none", "FLINT/Arb"] },
              "certified": { "type": "boolean" },
              "precision_bits": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}

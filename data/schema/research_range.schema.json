{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lumina-dev-ace/Riemann-Search-for-App/blob/main/data/schema/research_range.schema.json",
  "title": "RiemannSearch Verified Numerical Range",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "start_index", "end_index", "computation", "verification", "contributor_id", "submitted_at", "results", "integrity"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "riemannsearch-zero-range" },
    "start_index": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "end_index": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "computation": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "backend_version", "algorithm", "precision_digits"],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "backend_version": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 },
        "precision_digits": { "type": "integer", "minimum": 2 }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "precision_digits", "status", "interval_verification"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "precision_digits": { "type": "integer", "minimum": 2 },
        "status": { "enum": ["verified", "certified_interval_rechecked"] },
        "interval_verification": { "type": "boolean" }
      }
    },
    "contributor_id": { "type": "string", "minLength": 1 },
    "submitted_at": { "type": "string", "minLength": 1 },
    "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } },
    "integrity": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "sha256"],
      "properties": { "algorithm": { "const": "sha256" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    }
  },
  "$defs": {
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["zero_index", "real_part", "imag_part", "residual", "verification_residual", "precision_digits", "verification_precision_digits", "verification_status", "verification_method", "real_enclosure", "imag_enclosure", "certified_interval", "computed_at", "computation_time_ms", "verification_time_ms"],
      "properties": {
        "zero_index": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "real_part": { "type": "string", "minLength": 1 },
        "imag_part": { "type": "string", "minLength": 1 },
        "residual": { "type": "string", "minLength": 1 },
        "verification_residual": { "type": "string", "minLength": 1 },
        "precision_digits": { "type": "integer", "minimum": 2 },
        "verification_precision_digits": { "type": "integer", "minimum": 2 },
        "verification_status": { "enum": ["verified", "certified_interval_rechecked"] },
        "verification_method": { "type": "string", "minLength": 1 },
        "real_enclosure": { "type": ["string", "null"] },
        "imag_enclosure": { "type": ["string", "null"] },
        "certified_interval": { "type": "boolean" },
        "computed_at": { "type": "string", "minLength": 1 },
        "computation_time_ms": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$" },
        "verification_time_ms": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$" }
      }
    }
  }
}
